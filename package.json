{
  "name": "radiogridxl",
  "version": "7.24.1",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Single-file HTML5 radio streaming kiosk interface",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run test:smoke && npm run test:dom",
    "test:smoke": "node smoke-test.mjs",
    "test:dom": "node --test \"tests/*.test.mjs\"",
    "sync:radio": "node sync-radio-to-marshcity.mjs",
    "deploy:radio": "node sync-radio-to-marshcity.mjs --deploy",
    "guide:capture": "node guide/capture.mjs",
    "check:shelves": "node check-shelves.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "jsdom": "30.1.3",
    "jsqr": "1.4.0",
    "playwright": "1.64.1",
    "qrcode-generator": "2.0.4"
  }
}
